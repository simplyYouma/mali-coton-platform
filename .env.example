# Mode API : 'mock' (défaut) → MSW intercepte tout, ou 'live' → backend réel.
VITE_API_MODE=mock

# Base URL du backend en mode live (ignoré en mock).
# Le suffixe /api est ajouté automatiquement.
VITE_API_BASE_URL=http://187.127.225.182

# Token KoboToolbox pour afficher les photos des collectes terrain.
# → KoboToolbox → clic sur l'avatar en haut à droite → Account Settings → API token
# Copier le token (longue chaîne alphanumérique) et le coller ici (sans guillemets).
VITE_KOBO_API_TOKEN=

# Pour basculer en live, créer un .env.local avec :
#   VITE_API_MODE=live
#   VITE_API_BASE_URL=http://187.127.225.182
#   VITE_KOBO_API_TOKEN=votre_token_kobo
